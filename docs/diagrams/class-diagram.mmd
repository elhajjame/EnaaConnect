%% EnaaConnect Mongoose models and schema references currently in server/models.
%% The User verification fields exist in the schema, but no verification route is mounted.
%% Notification.relatedEntity is an untyped ObjectId, not a Mongoose ref.
%% Post.likes stores User ObjectIds. There is no separate Like model.
classDiagram
  direction LR

  class User {
    +ObjectId _id
    +String fullName
    +String email
    +String password
    +String confirmPassword
    +String role
    +Boolean isVerified
    +String fieldOfStudy
    +String academicYear
    +String profilePicture
    +String biography
    +String[] interests
    +String verificationToken
    +Date verificationTokenExpires
    +Date passwordChangedAt
    +Date createdAt
    +Date updatedAt
  }

  class Post {
    +ObjectId _id
    +ObjectId author
    +String content
    +String[] images
    +ObjectId[] likes
    +ObjectId[] comments
    +Date createdAt
    +Date updatedAt
  }

  class Comment {
    +ObjectId _id
    +ObjectId post
    +ObjectId author
    +String content
    +Date createdAt
    +Date updatedAt
  }

  class Event {
    +ObjectId _id
    +String title
    +String description
    +Date date
    +String time
    +String location
    +String category
    +Number maximumParticipants
    +ObjectId organizer
    +ObjectId[] participants
    +String status
    +ObjectId reviewedBy
    +Date reviewedAt
    +Date createdAt
    +Date updatedAt
  }

  class Notification {
    +ObjectId _id
    +ObjectId recipient
    +ObjectId actor
    +String type
    +String message
    +String relatedEntityType
    +ObjectId relatedEntity
    +Boolean isRead
    +Date createdAt
    +Date updatedAt
  }

  note for Post "likes stores User IDs; the controller adds or removes the signed-in user"
  note for Notification "post_like is created only when a like is added to another user's post"

  User "1" --> "0..*" Post : author
  Post "0..*" --> "0..*" User : likes
  Post "1" --> "0..*" Comment : comments
  User "1" --> "0..*" Comment : author

  User "1" --> "0..*" Event : organizer
  User "0..*" -- "0..*" Event : participants
  User "0..1" --> "0..*" Event : reviewedBy

  User "1" --> "0..*" Notification : recipient
  User "0..1" --> "0..*" Notification : actor
