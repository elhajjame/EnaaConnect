%%{init: {"flowchart": {"htmlLabels": true, "curve": "basis"}} }%%
flowchart LR

%% Actors
A_Guest(["Guest"])
A_Student(["Student"])
A_Leader(["Club Leader"])
A_Admin(["Administrator"])

%% A club leader is a student assigned as the leader of a club.
A_Leader -.->|"specializes"| A_Student

subgraph SYS["EnaaConnect System"]
  subgraph AUTH["Authentication"]
    UC_Register(("Register"))
    UC_VerifyEmail(("Verify Email"))
    UC_Login(("Login"))
    UC_Logout(("Logout"))
    UC_ResetPassword(("Reset Password"))
    UC_SendVerification(("Send Verification Email"))
    UC_SendReset(("Send Reset Email"))
    UC_ValidateCredentials(("Validate Credentials"))
  end

  subgraph PROFILE["Profile"]
    UC_ViewProfile(("View Profile"))
    UC_EditProfile(("Edit Profile"))
    UC_UploadPicture(("Upload Profile Picture"))
  end

  subgraph POSTS["Student Feed"]
    UC_CreatePost(("Create Post"))
    UC_EditOwnPost(("Edit Own Post"))
    UC_DeleteOwnPost(("Delete Own Post"))
    UC_LikePost(("Like / Unlike Post"))
    UC_CommentPost(("Comment on Post"))
    UC_ValidatePost(("Validate Post Content"))
  end

  subgraph EVENTS["Events"]
    UC_CreateEvent(("Create Event"))
    UC_EditOwnEvent(("Edit Own Event"))
    UC_DeleteOwnEvent(("Delete Own Event"))
    UC_ViewEvents(("View Approved Events"))
    UC_JoinEvent(("Join Event"))
    UC_LeaveEvent(("Leave Event"))
    UC_CommentEvent(("Comment on Event"))
    UC_ShareEvent(("Share Event Link"))
    UC_CheckEventCapacity(("Check Event Capacity"))
  end

  subgraph CLUBS["Clubs"]
    UC_CreateClub(("Create Club"))
    UC_JoinClub(("Join Club"))
