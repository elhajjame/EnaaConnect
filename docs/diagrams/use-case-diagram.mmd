    UC_EditManagedClub(("Edit Managed Club"))
    UC_ManageMembers(("Manage Club Members"))
    UC_PublishAnnouncement(("Publish Club Announcement"))
  end

  subgraph MESSAGING["Messaging"]
    UC_CreateConversation(("Create Private Conversation"))
    UC_CreateGroup(("Create Group Conversation"))
    UC_SendMessage(("Send Message"))
    UC_ReceiveMessage(("Receive Message"))
    UC_ShareAttachment(("Share File / Document"))
  end

  subgraph TRIPS["Trips"]
    UC_CreateTrip(("Create Trip"))
    UC_EditOwnTrip(("Edit Own Trip"))
    UC_DeleteOwnTrip(("Delete Own Trip"))
    UC_JoinTrip(("Join Trip"))
