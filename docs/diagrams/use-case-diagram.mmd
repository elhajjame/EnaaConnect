%% Included behavior
UC_Register -.->|"<<include>>"| UC_SendVerification
UC_Login -.->|"<<include>>"| UC_ValidateCredentials
UC_ResetPassword -.->|"<<include>>"| UC_SendReset
UC_CreatePost -.->|"<<include>>"| UC_ValidatePost
UC_EditOwnPost -.->|"<<include>>"| UC_ValidatePost
UC_CreateClub -.->|"<<include>>"| UC_AssignCreatorLeader
UC_JoinEvent -.->|"<<include>>"| UC_CheckEventCapacity
UC_JoinTrip -.->|"<<include>>"| UC_CheckTripCapacity
UC_CreateGroup -.->|"<<include>>"| UC_CreateConversation
UC_ShareAttachment -.->|"<<include>>"| UC_SendMessage
UC_LikePost -.->|"<<include>>"| UC_CreateNotification
UC_CommentPost -.->|"<<include>>"| UC_CreateNotification
UC_CommentEvent -.->|"<<include>>"| UC_CreateNotification
UC_JoinEvent -.->|"<<include>>"| UC_CreateNotification
UC_JoinClub -.->|"<<include>>"| UC_CreateNotification
UC_SendMessage -.->|"<<include>>"| UC_CreateNotification
UC_PublishAnnouncement -.->|"<<include>>"| UC_CreateNotification

%% Optional result of reviewing a report
UC_DeleteContent -.->|"<<extend>>"| UC_ReviewReports

