%% EnaaConnect use cases from mounted backend routes and connected frontend pages.
%% Green: connected frontend flow. Blue: implemented backend API without a connected screen.
flowchart LR
  Visitor(["Visitor"])
  Student(["Student"])
  Admin(["Administrator"])

  subgraph Account["Account and profile"]
    Register(("Register student account"))
    Login(("Log in"))
    Logout(("Log out"))
    OwnProfile(("View own profile"))
    EditProfile(("Edit own profile"))
    UploadPhoto(("Upload profile photo"))
    StudentProfile(("View a student profile - API only"))
  end

  subgraph Posts["Posts and comments"]
    ViewPosts(("View posts and like counts"))
    ViewOwnPosts(("View own posts"))
    CreatePost(("Create post"))
    LikePost(("Like post"))
    UnlikePost(("Unlike post"))
    EditPost(("Edit own post - API only"))
    DeletePost(("Delete own post - API only"))
    ViewComments(("View post comments - API only"))
    AddComment(("Comment on post - API only"))
  end

  subgraph Events["Events"]
    ViewEvents(("View approved events"))
    CreateEvent(("Submit event for approval"))
    JoinEvent(("Join approved event"))
    LeaveEvent(("Leave joined event"))
    ViewParticipants(("View event participants - API only"))
    ViewPending(("View pending events"))
    ReviewEvent(("Approve or reject event"))
  end

  subgraph Notifications["Notifications"]
    LikeNotification["Notify post author of a like"]
    ViewNotifications(("View own notifications - API only"))
    ReadNotification(("Mark own notification as read - API only"))
    ReadAll(("Mark all own notifications as read - API only"))
  end

